{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('username').val() === newData.child('username').val())",
        ".validate": "newData.hasChildren(['username', 'createdAt']) && newData.child('username').isString() && newData.child('username').val().matches(/^[a-z0-9_]{3,20}$/) && newData.child('createdAt').isNumber()"
      }
    },

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.child('username').val() === root.child('users').child(auth.uid).child('username').val()",
        ".validate": "newData.hasChildren(['username', 'state', 'lastChanged']) && newData.child('username').isString() && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('lastChanged').isNumber()"
      }
    },

    "messages": {
      "$channel": {
        ".read": "auth != null && ($channel === 'general' || $channel === 'random' || $channel === 'memes')",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('username').val() === root.child('users').child(auth.uid).child('username').val() && ($channel === 'general' || $channel === 'random' || $channel === 'memes')",
          ".validate": "newData.hasChildren(['uid', 'username', 'text', 'createdAt']) && newData.child('uid').isString() && newData.child('username').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000 && newData.child('createdAt').isNumber()"
        }
      }
    }
  }
}
